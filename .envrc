# dotenvrc: 12-factor pattern with b00t validation & direnv
# ============================================================
# 1. Load b00t and validate project environment
# 2. Load .env secrets via dotenv
# 3. Validate required keys for enabled features
# 4. Gate features gracefully if keys are missing

set -e

# === Phase 1: b00t initialization ===
export _B00T_PATH="${PWD}"

# Load b00t if available (graceful fallback if not)
if command -v b00t &> /dev/null; then
  eval "$(b00t config env --direnv)" || true
fi

# === Phase 2: Load .env secrets ===
# dotenv loads .env file (may be created/updated by b00t earlier)
if [ -f .env ]; then
  dotenv ".env"
else
  echo "⚠️  .env not found. Copy .env.example: cp .env.example .env"
fi

# === Phase 3: Validate required keys & gate features ===
validate_key() {
  local key=$1
  local feature=$2
  if [ -z "${!key}" ]; then
    echo "❌ Missing: $key (required for $feature)"
    return 1
  fi
}

feature_available() {
  local key=$1
  local feature=$2
  if [ -z "${!key}" ]; then
    echo "⚠️  $feature DISABLED: missing $key"
    return 1
  fi
  echo "✅ $feature enabled"
  return 0
}

# Image generation providers
feature_available "CLOUDFLARE_API_TOKEN" "Cloudflare Workers AI image generation"
feature_available "HUGGINGFACE_API_KEY" "Hugging Face image generation"

# Required for all: Cloudflare bindings
validate_key "CLOUDFLARE_ACCOUNT_ID" "Cloudflare integration" || \
  echo "⚠️  Set CLOUDFLARE_ACCOUNT_ID for full functionality"

# Database
validate_key "DATABASE_URL" "D1 database" || \
  echo "⚠️  Set DATABASE_URL (or use wrangler d1 local)"

# === Phase 4: Display status ===
echo ""
echo "═══════════════════════════════════════"
echo "📦 Environment Status"
echo "═══════════════════════════════════════"
echo "Project: website-promptexecution"
echo "Branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
echo ""
[ -z "$CLOUDFLARE_API_TOKEN" ] || echo "✅ Cloudflare Workers AI"
[ -z "$HUGGINGFACE_API_KEY" ] || echo "✅ Hugging Face API"
[ -z "$DATABASE_URL" ] || echo "✅ D1 Database"
echo "═══════════════════════════════════════"
echo ""

set +e
